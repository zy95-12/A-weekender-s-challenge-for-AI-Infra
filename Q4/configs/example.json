{
  "model": {
    "name": "Qwen/Qwen3-32B",
    "hf_config_path": "../models/qwen3_32b_config.json"
  },
  "topology": {
    "stages": [
      {
        "name": "edge_front",
        "layer_start": 0,
        "layer_end": 6,
        "resource": "edge_gpu",
        "tp_degree": 1,
        "pp_degree": 1,
        "replicas": 1
      },
      {
        "name": "cloud_middle",
        "layer_start": 6,
        "layer_end": 62,
        "resource": "cloud_gpu",
        "tp_degree": 4,
        "pp_degree": 2,
        "pp_layer_ranges": [[6, 34], [34, 62]],
        "replicas": 1
      },
      {
        "name": "edge_tail",
        "layer_start": 62,
        "layer_end": 64,
        "resource": "edge_gpu",
        "tp_degree": 1,
        "pp_degree": 1,
        "replicas": 1
      }
    ]
  },
  "hardware": {
    "edge_gpu": {
      "count": 1,
      "peak_flops_tflops": 148,
      "hbm_bandwidth_gb_s": 4000,
      "memory_gb": 96,
      "compute_efficiency": 0.65,
      "memory_efficiency": 0.70,
      "kernel_overhead_us": 10
    },
    "cloud_gpu": {
      "count": 8,
      "peak_flops_tflops": 148,
      "hbm_bandwidth_gb_s": 4000,
      "memory_gb": 96,
      "compute_efficiency": 0.65,
      "memory_efficiency": 0.70,
      "kernel_overhead_us": 10,
      "interconnect_bandwidth_gb_s": 400,
      "interconnect_latency_us": 5
    }
  },
  "network": {
    "uplink_gbps": 10,
    "downlink_gbps": 10,
    "rtt_ms": 10,
    "efficiency": 0.8
  },
  "static_policy": {
    "batch_size": 8,
    "max_batched_tokens": 8192,
    "prefill_token_budget": 512,
    "prefill_chunk_size": 512,
    "continuous_batching": {"enabled": true},
    "pipeline_depth": 4,
    "max_outstanding_prefill_chunks": 16,
    "dispatch_mode": "eager"
  },
  "attention_backend": {"mode": "unified"},
  "scheduler": {
    "policy": "fcfs",
    "max_num_seqs": 8,
    "enable_chunked_prefill": true,
    "kv_cache": {"enabled": false, "block_size_tokens": 16, "num_blocks": 0, "watermark": 0.0, "prefix_caching": false, "enable_preemption": true, "preemption_mode": "recompute"},
    "pd_disaggregation": {"enabled": false, "kv_transfer_bandwidth_gb_s": 100, "kv_transfer_latency_ms": 0.1}
  },
  "workload": {
    "mode": "synthetic",
    "num_requests": 4,
    "arrival_process": "constant",
    "arrival_interval_ms": 10,
    "input_tokens": 512,
    "output_tokens": 8,
    "random_seed": 42
  },
  "slo": {
    "ttft_ms": 3000,
    "tpot_ms": 100
  },
  "simulation": {
    "max_time_s": 3600,
    "trace_enabled": true
  }
}
